# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
# Public URL of the deployed backend (for CORS in production, email links)
FRONTEND_URL=http://localhost:5173

# ── Groq AI ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── MySQL Database ────────────────────────────────────────────────────────
# Option A: Connection string
DATABASE_URL=mysql://25oVkhhBhFNtX2M.root:6bWtoaj8O4ywxHS1@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/cleaning_platform?ssl={"rejectUnauthorized":true}
# Legacy local MySQL (commented out — TiDB Cloud is now active)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Pranav@123
DB_NAME=cleaning_platform

# ── Portal Accounts (pre-seeded in database) ─────────────────────────
# Super Admin (Full Access)
ADMIN_EMAIL=admin@ganga-maxx.com
ADMIN_PASSWORD=Pranav@123
