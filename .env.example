# ──────────────────────────────────────────────────────────────────────────
# Ganga Maxx - AI Institutional Cleaning Product Selector
# Environment Variables Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173
# Public URL of the deployed backend (for CORS in production, email links)
FRONTEND_URL=http://localhost:5173

# ── Vercel Deployment (set automatically by Vercel when deployed) ──────────
VERCEL=1
VERCEL_URL=your-app.vercel.app
VERCEL_PROJECT_PRODUCTION_URL=your-app.vercel.app

# ── Frontend Vite Build ────────────────────────────────────────────────────
# Override the base path for assets (default is auto-detected from VERCEL env)
VITE_BASE_URL=/

# ── JWT Secret ──────────────────────────────────────────────────────────
# Generate a secure random string. If not set, a deterministic secret will
# be derived from the Vercel project URL in production.
JWT_SECRET=your-secure-jwt-secret-here-change-in-production

# ── MySQL Database ────────────────────────────────────────────────────────
# Option A: Connection string
# DATABASE_URL=mysql://user:password@host:3306/database
# Option B: Individual credentials
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=cleaning_platform

# ── Portal Accounts (pre-seeded in database) ─────────────────────────
# Super Admin (Full Access)
ADMIN_EMAIL=admin@ganga-maxx.com
ADMIN_PASSWORD=Pranav@123
#
# All pre-seeded portal accounts:
# ┌─────────────────────┬──────────────────────────────┬────────────────────┬──────────────────────┐
# │ Role                │ Email                        │ Password           │ Access               │
# ├─────────────────────┼──────────────────────────────┼────────────────────┼──────────────────────┤
# │ Super Admin         │ admin@ganga-maxx.com         │ Pranav@123         │ Full Access          │
# │ Sales Admin         │ salesadmin@ganga-maxx.com    │ salesadmin@123     │ Full Access          │
# │ Salesman            │ salesman@ganga-maxx.com      │ salesman@123       │ Customer Data        │
# │ Warehouse Staff     │ warehouse@ganga-maxx.com     │ warehouse@123      │ Inventory            │
# │ Accounts Manager    │ accounts@ganga-maxx.com      │ accounts@123       │ Payments             │
# │ Compliance Admin    │ compliance@ganga-maxx.com    │ compliance@123     │ Compliance Reports   │
# │ Dealer              │ dealer@ganga-maxx.com        │ dealer@123         │ Bulk Orders          │
# │ Facility Manager    │ manager@ganga-maxx.com       │ manager@123        │ Requirements Form    │
# └─────────────────────┴──────────────────────────────┴────────────────────┴──────────────────────┘

# ── Google OAuth (optional - for Google Sign-In) ────────────────────────
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── EmailJS (optional - for sending recommendation reports) ──────────────
# Get keys at: https://dashboard.emailjs.com
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=your-emailjs-template-id

# ── Resend (optional - for transactional emails like password reset) ─────
# Get key at: https://resend.com
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=auth@ganga-maxx.com

# ── Frontend Vite Variables (must be prefixed with VITE_) ─────────────────
# Base URL for API requests (leave empty to use Vite proxy in dev)
VITE_API_URL=
# Google Client ID (passed from backend config, but can be set directly)
VITE_GOOGLE_CLIENT_ID=
# Enable analytics tracking
VITE_ANALYTICS_ENABLED=false
